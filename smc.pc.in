prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: smc
Description: Self-Modifying Calculator — embeddable adaptive computation library
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lsmc
Libs.private: -lm
Cflags: -I${includedir}
